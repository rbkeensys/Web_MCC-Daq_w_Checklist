{
  "drive_type": "h100",
  "drive_name": "QNK H100 (5.5S2-1B) / V70",
  "source": "QNK/H100 user manual Ch.5-6 (uploaded pp.20-21,31,78-81) + verified H100 profile in vfd_driver.py",
  "address_rule": "F<nnn>: holding-register address = decimal nnn as hex. e.g. F100->0x0064, F005->0x0005, F164->0x00A4. (Verified in manual p79.)",
  "access_legend": {
    "rw": "changeable while running (manual \u25a2)",
    "stop": "changeable only when stopped (manual \u00d7)",
    "ro": "read-only (manual \u0394)"
  },
  "param_read_fn": "0x03",
  "param_write_fn": "0x06",
  "monitor_read_fn": "0x04",
  "command_model": "coils via fn 0x05 (writable cmd coils from 0x0048; run 0x0049 fwd / 0x004A rev / 0x004B stop per profile). Freq setpoint = comm special var 0x0201 (fn 0x06), direct 0.1Hz.",
  "notes": [
    "CURATED subset mirroring vfd_params_gk3000.json -- not the full F000-F185 table.",
    "06H writes a single holding reg for all params; F013/F172 are 06H-only (no 10H, no response frame).",
    "Comm-special variables (>=0x0200) are RAM-only; F-params persist to EEPROM (don't rewrite frequently).",
    "Freq limits: F005 = max operating frequency (upper), F011 = lower frequency limit.",
    "UNVERIFIED: F140/F141/F142 decimal scaling -- confirm before build_motor_setup writes H100 nameplate values."
  ],
  "baud_param": {
    "token": "F164",
    "address": "0x00A4",
    "code_map": {
      "4800": 0,
      "9600": 1,
      "19200": 2,
      "38400": 3
    },
    "max_baud": 38400,
    "note": "H100 cannot exceed 38400."
  },
