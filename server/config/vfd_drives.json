      "default_stopbits": 2,
      "default_address": 1,
      "notes": "Freq setpoint is % of max freq (0x5000, +/-10000 = +/-100% of P0.05). REQUIRES P0.03=2 (comm command/run) AND P0.01=9 (comm frequency source). Max/upper/lower freq limits (P0.05/06/07) are applied from the MOTOR's max_hz/min_hz (vfd_motors.json), not here -- keep motor.max_hz == drive max freq. Default 9600 8-N-2.",
      "setup_params": [
        {
          "name": "P0.01",
          "register": 61441,
          "value": 9,
          "desc": "frequency source 1 = 485 communication (honor the 0x5000 setpoint)"
        },
        {
          "name": "P0.03",
          "register": 61443,
          "value": 2,
          "desc": "command source = serial"
        },
        {
          "name": "PC.02",
          "register": 64514,
          "value": 1,
          "desc": "local address (1)"
        },
        {
          "name": "PC.00",
          "register": 64512,
          "value": 5,
          "desc": "baud 9600"
        },
        {
          "name": "PC.01",
