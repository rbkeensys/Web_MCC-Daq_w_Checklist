{
  "drive_type": "gk3000",
  "drive_name": "ATO GK3000",
  "source": "ATO GK3000 user manual Ch.5 (function parameter table) + Ch.9 (Modbus map) + Group PC comms table (manual pp.85-86)",
  "address_rule": "P<group>.<reg>: address = 0xF000 + group_hex*0x100 + reg_decimal. e.g. P0.03->0xF003, P6.10->0xF60A, PB.16->0xFB10",
  "param_read_fn": "0x03",
  "param_write_fn": "0x06",
  "param_save_fn": "0x07",
  "access_legend": {
    "rw": "modifiable while running",
    "stop": "modifiable only when stopped",
    "ro": "read-only"
  },
